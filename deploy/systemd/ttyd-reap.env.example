# Copy to ~/.config/ttyd-reap.env — read by ttyd-reap-idle.service.
#
# How long a session must sit with no pane output before it is snapshotted and
# closed. Accepts 3d / 12h / 90m / bare seconds.
#
# This is the default. A single session can carry its own threshold, set from
# the URL that opened it — ?arg=idle:1h — or opt out entirely with ?arg=noreap.
# Those beat the value here.
TTYD_REAP_IDLE=12h

# Sessions that are never reaped, whatever their idle time. Comma separated.
# A session can also opt out from the inside, without touching this file:
#   ?arg=noreap  on the URL that opens it, or
#   tmux set-option -t <session>: @ttyd-no-reap 1
#
# Note: only sessions ttyd-pro created are candidates in the first place. The
# reaper skips anything absent from its registry ($TTYD_STATE_DIR/owned/),
# so tmux sessions started by the gateway or by hand are never touched.
#TTYD_REAP_KEEP=main,build-box

# How long a snapshot of a closed session is kept before it is pruned. After
# this, reopening the name gives a fresh session instead of the old screen.
#TTYD_SNAPSHOT_KEEP_DAYS=30

# Lines of scrollback captured per pane at snapshot time.
#TTYD_SNAPSHOT_SCROLLBACK=5000
